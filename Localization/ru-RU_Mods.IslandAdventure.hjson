NPCs: {
	Mermaid: {
		DisplayName: Русалка
		Bestiary: Плавает у берегов острова и бросается на тех, кто заплывает слишком близко. На суше почти беспомощна.
	}

	Merman: {
		DisplayName: Русал
		Bestiary: Более крупный морской житель. Преследует пловцов у берегов острова, но на суше теряет подвижность.
	}

	MermaidQueen: {
		DisplayName: Королева Русалок
		Bestiary: Владычица океана, чьё чарующее пение сбивает путников с толку. Атакует рывками, поднимает всё более высокие волны и призывает мурен.
	}

	RoyalMoray.DisplayName: Королевская мурена
}

